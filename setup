#!/bin/sh
# The installer's front door — and deliberately almost nothing.
#
# This does the one job Python cannot do for itself: establish that a usable python3 exists
# before handing over to it. Every decision, prompt and write lives in the Python installer,
# where it is readable, testable and shared with `selly-agent update`. POSIX sh, no bashisms:
# it is five lines of checking, and one shell dialect across both entry points keeps them
# reviewable together.

set -eu

here=$(cd "$(dirname "$0")" && pwd)

if ! command -v python3 >/dev/null 2>&1; then
	echo "SELLY: python3 is required, and there isn't one on your PATH." >&2
	echo "SELLY:   macOS can install it for you: xcode-select --install" >&2
	exit 1
fi

if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)'; then
	echo "SELLY: python3 3.9 or newer is required (found: $(python3 -V 2>&1))." >&2
	echo "SELLY:   Install a newer one (https://www.python.org/downloads/macos/) and re-run ./setup" >&2
	exit 1
fi

exec python3 "$here/bin/selly-agent" setup "$@"
